# ============================================================
# ORTAM DEĞİŞKENLERİ ŞABLONU
# ------------------------------------------------------------
# Bu dosyayı kopyalayıp doldurun:
#   - Lokal geliştirme için:  cp .env.example .env.local
#   - Üretim için:            cp .env.example .env
# Gerçek değerleri ASLA bu dosyaya (.env.example) yazmayın.
# .env ve .env.local git'e GİRMEZ (.gitignore).
# ============================================================

# Veritabanı
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Uygulama (base URL, trailing slash ile)
APP_BASE_URL=https://example.com/

# Uygulama şifreleme anahtarı — bildirim sırlarını (Telegram bot token,
# SMS auth token, SMTP şifresi) veritabanında şifrelemek için kullanılır.
# Üretmek için:  php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# veya:          openssl rand -base64 32  (başına "base64:" ekleyin)
# Bu anahtarı GİZLİ tutun ve DEĞİŞTİRMEYİN (değişirse eski şifreli kayıtlar okunamaz).
APP_KEY=

# ============================================================
# ÜRETİM (PRODUCTION) KURULUMU
# ------------------------------------------------------------
# .env.local dosyasını MUTLAKA public_html DIŞINA koyun:
#
#   /home/<user>/domains/<domain>/.env.local      <-- GÜVENLİ
#   /home/<user>/domains/<domain>/public_html/    <-- uygulama burada
#
# config/env.php otomatik olarak public_html'in bir üst dizinine
# bakar ve .env.local / .env dosyalarını yükler. Bu şekilde
# kimlik bilgileri web üzerinden ASLA erişilebilir olmaz.
#
# Bu dosyayı (şablonu) public_html içine koymayın; sunucuda elle
# oluşturun ve chmod 600 ile koruyun.
# ============================================================

# ------------------------------------------------------------
# NOT: SMTP, Telegram, SMS ve Webhook ayarları kodda DEĞİL,
# uygulama içindeki admin panelinden (DB'ye) girilir.
# Bu yüzden burada yer almazlar.
# ------------------------------------------------------------
